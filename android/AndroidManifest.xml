<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.hypershare.app">

    <!-- Network & Local Hotspot Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 
      CRITICAL PERMISSION STRATEGY:
      In Android 13+ (API 33+), we use NEARBY_WIFI_DEVICES with 'neverForLocation'.
      This completely eliminates the need for GPS/Location permission!
      The user is NEVER prompted to turn on Location services.
    -->
    <uses-permission 
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Camera is only needed if this phone wants to scan the other phone's QR code -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- NO BLUETOOTH PERMISSIONS NEEDED: Pairings are 100% optical via QR Code -->
    <!-- NO GPS LOCATION PERMISSIONS NEEDED -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="HyperShare"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperShare"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Support receiving files shared from other apps via Android Share Sheet -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".HotspotService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
    </application>

</manifest>
